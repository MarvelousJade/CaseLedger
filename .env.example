# Local Docker Compose settings only. Do not place hosted credentials in this file.
POSTGRES_PASSWORD=replace-with-a-local-database-password
RABBITMQ_PASSWORD=replace-with-a-local-broker-password
CASELEDGER_ADMIN_PASSWORD=replace-with-a-local-demo-password
CASELEDGER_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters
