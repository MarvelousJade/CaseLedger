		variation Variation
			isDefault
			relationship: 648b82b6-6f9e-4d8d-a2b8-ea842fffca89
			defaultHierarchy: LocalDateTable_406fbf00-a823-46cb-a2f6-61de4fed9521.'Date Hierarchy'

	partition 'Data Quality' = m
