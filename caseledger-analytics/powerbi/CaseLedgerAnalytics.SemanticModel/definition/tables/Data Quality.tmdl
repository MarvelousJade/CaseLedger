table 'Data Quality'
	lineageTag: 22259a54-f86d-4822-be84-8febc70c92f2

	measure 'Failed Quality Checks' = COALESCE(CALCULATE(COUNTROWS('Data Quality'), 'Data Quality'[Passed] = FALSE()), 0)
