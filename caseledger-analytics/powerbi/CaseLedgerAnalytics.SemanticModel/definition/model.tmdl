model Model

	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	queryGroup 'Reporting Marts'

	expression SqlServerHost = "\"warehouse\"" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

		annotation PBI_NavigationStepName = Navigation

	expression SqlServerDatabase = "\"CaseLedgerAnalytics\"" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

		annotation PBI_NavigationStepName = Navigation

	annotation PBI_QueryOrder = ["SqlServerHost","SqlServerDatabase","Date","Operations Daily","Case Aging","SLA Compliance","Integration Reliability","Data Quality","ETL Run History"]
