{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "CaseLedger": "Data Source=caseledger.db"
  },
  "EvidenceStorage": {
    "Provider": "Local",
    "MaxFileSizeBytes": 26214400,
    "Local": {
      "RootPath": "App_Data/evidence"
    },
    "AzureBlob": {
      "AccountUri": "",
      "ContainerName": "caseledger-evidence",
      "ManagedIdentityClientId": ""
    }
  },
  "DataProtection": {
    "Azure": {
      "Enabled": false,
      "KeyBlobUri": "",
      "KeyVaultKeyIdentifier": "",
      "ManagedIdentityClientId": ""
    }
  },
  "Messaging": {
    "Enabled": false,
    "Provider": "RabbitMq",
    "RabbitMq": {
      "Uri": ""
    },
    "AzureServiceBus": {
      "ConnectionString": "",
      "FullyQualifiedNamespace": "",
      "ManagedIdentityClientId": "",
      "TopicName": "",
      "ResultSubscriptionName": ""
    },
    "PollingIntervalMilliseconds": 1000,
    "BatchSize": 20,
    "LeaseSeconds": 30,
    "MaxAttempts": 8,
    "MaximumMessageBytes": 196608
  },
  "Webhook": {
    "Enabled": false,
    "DestinationUrl": "",
    "SigningSecret": "",
    "AllowInsecureHttp": false,
    "PollingIntervalMilliseconds": 1000,
    "BatchSize": 20,
    "LeaseSeconds": 30,
    "MaxAttempts": 8,
    "TimeoutSeconds": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
